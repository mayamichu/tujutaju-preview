[{"id":"wshop01","elType":"widget","widgetType":"html","settings":{"html":"<link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Source+Sans+3:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"@id\":\"https://tujutaju.ee/workshop/#service\",\"name\":\"Six languages of communication workshop\",\"description\":\"An in-person, practical introduction to Process Communication Model in which participants try six ways of perceiving and expressing a message.\",\"url\":\"https://tujutaju.ee/workshop/\",\"serviceType\":\"Communication workshop\",\"provider\":{\"@type\":\"Person\",\"name\":\"Maia Mitšulis\",\"jobTitle\":\"Certified Process Communication Model trainer\",\"url\":\"https://tujutaju.ee/about/\"},\"areaServed\":{\"@type\":\"Country\",\"name\":\"Estonia\"},\"availableLanguage\":[\"English\",\"Estonian\",\"Russian\"]}\n</script>\n<style>\nbody{margin:0;background:#fff}\n#tt-workshop-page{--tt-blue:#626E98;--tt-pink:#EEBCBC;--tt-yellow:#FFE193;--tt-blue-soft:#EBECF2;--tt-pink-soft:#FFF0F4;--tt-yellow-soft:#FFF4D6;--tt-hover-pink:#FFD3DE;box-sizing:border-box;color:var(--tt-blue);font-family:\"Source Sans 3\",sans-serif;font-size:17px;line-height:1.58}\n#tt-workshop-page *{box-sizing:border-box}\n#tt-workshop-page .tt-container{width:min(1160px,calc(100% - 80px));margin:0 auto}\n#tt-workshop-page p{margin:0;color:var(--tt-blue);font:inherit}\n#tt-workshop-page h1,#tt-workshop-page h2,#tt-workshop-page h3{margin:0;font-family:Poppins,sans-serif;font-weight:700;line-height:1.2;color:var(--tt-blue)}\n#tt-workshop-page .tt-kicker{margin:0 0 14px;font-family:Poppins,sans-serif;font-size:14px;font-weight:700;line-height:1.45;letter-spacing:.06em;text-transform:uppercase;color:var(--tt-blue)}\n#tt-workshop-page .tt-section-title{font-size:clamp(32px,3.2vw,44px);letter-spacing:-.02em}\n#tt-workshop-page .tt-button{display:inline-flex;align-item
e .tt-details-grid{grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr)}\n #tt-workshop-page .tt-fact{padding:18px}\n}\n@media(min-width:601px) and (max-width:850px) and (min-height:501px) and (orientation:portrait){\n #tt-workshop-page .tt-container{width:calc(100vw - 80px);max-width:none}\n #tt-workshop-page .tt-hero-grid{grid-template-columns:1fr;gap:30px}\n #tt-workshop-page .tt-hero-photo{height:auto;aspect-ratio:1.6/1}\n #tt-workshop-page .tt-experience-panel{grid-template-columns:1fr;gap:30px}\n #tt-workshop-page .tt-discover-grid{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:32px}\n #tt-workshop-page .tt-discover-card:last-child{grid-column:1/-1;max-width:calc(50% - 13px)}\n #tt-workshop-page .tt-details-grid{grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:32px}\n #tt-workshop-page .tt-next-panel,#tt-workshop-page .tt-cta-panel{grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:32px}\n}\n@media(max-width:600px){\n #tt-workshop-page .tt-container{width:calc(100% - 48px)}\n #tt-workshop-page .tt-hero{padding-top:48px}\n #tt-workshop-page .tt-hero-grid{grid-template-columns:1fr;gap:28px}\n #tt-workshop-page .tt-hero h1{font-size:38px}\n #tt-workshop-page .tt-hero-lead{font-size:18px}\n #tt-workshop-page .tt-hero-photo{height:auto;aspect-ratio:1.08/1;border-radius:42px 42px 42px 0}\n #tt-workshop-page .tt-experience,#tt-workshop-page .tt-discover,#tt-workshop-page .tt-details,#tt-workshop-page .tt-next{padding-top:54px}\n #tt-workshop-page .tt-experience-panel{grid-template-columns:1fr;gap:28px;padding:28px 24px 32px;border-radius:42px 0 42px 42px}\n #tt-workshop-page .tt-experience-list{gap:22px}\n #tt-workshop-page .tt-experience-item{grid-template-columns:42px minmax(0,1fr);gap:15px}\n #tt-workshop-page .tt-experience-num{width:42px;height:42px}\n #tt-workshop-page .tt-section-title{font-size:32px}\n #tt-workshop-page .tt-discover-grid{grid-template-columns:1fr;gap:26px;margin-top:24px}\n #tt-workshop-page .tt-discover-card:last-child{grid-column:auto;max-width:none}\n #tt-workshop-page .tt-discover-card h3{font-size:21px}\n #tt-workshop-page .tt-details-grid{grid-template-columns:1fr;gap:26px}\n #tt-workshop-page .tt-details-facts{grid-template-columns:1fr 1fr;gap:12px;margin-top:22px}\n #tt-workshop-page .tt-fact{padding:16px}\n #tt-workshop-page .tt-fact strong{font-size:17px}\n #tt-workshop-page .tt-fact span{font-size:15px}\n #tt-workshop-page .tt-next-panel{grid-template-columns:1fr;gap:20px}\n #tt-workshop-page .tt-cta{padding:54px 0}\n #tt-workshop-page .tt-cta-panel{grid-template-columns:1fr;gap:24px;padding:30px 24px 32px;border-radius:42px 42px 0 42px}\n #tt-workshop-page .tt-cta-copy .tt-button{align-self:flex-start;margin-top:20px}\n}\n@media(min-width:601px) and (max-width:950px) and (max-height:500px) and (orientation:landscape){\n #tt-workshop-page .tt-container{width:min(1160px,calc(100% - 48px))}\n #tt-workshop-page .tt-hero{padding-top:32px}\n #tt-workshop-page .tt-hero-grid{grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:28px}\n #tt-workshop-page .tt-hero h1{font-size:36px}\n #tt-workshop-page .tt-hero-lead{font-size:16px;margin-top:12px}\n #tt-workshop-page .tt-hero-meta{margin-top:12px;font-size:14px}\n #tt-workshop-page .tt-hero .tt-button{margin-top:14px}\n #tt-workshop-page .tt-hero-photo{height:250px}\n #tt-workshop-page .tt-experience,#tt-workshop-page .tt-discover,#tt-workshop-page .tt-details,#tt-workshop-page .tt-next{padding-top:44px}\n #tt-workshop-page .tt-experience-panel{grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:28px;padding:26px 30px}\n #tt-workshop-page .tt-discover-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:22px}\n #tt-workshop-page .tt-details-grid{grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:32px}\n #tt-workshop-page .tt-next-panel,#tt-workshop-page .tt-cta-panel{grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:32px}\n #tt-workshop-page .tt-cta{padding:44px 0}\n #tt-workshop-page .tt-cta-panel{padding:28px 32px 32px}\n}\n</style>\n<div id=\"tt-workshop-page\">\n<main>\n<section class=\"tt-hero\"><div class=\"tt-container\"><div class=\"tt-hero-grid\"><div class=\"tt-hero-copy\"><p class=\"tt-kicker\">PCM WORKSHOP</p><h1>Six languages of communication</h1><p class=\"tt-hero-lead\">What changes when you look at the same situation through six different perspectives? Try it together, and experience how much the way we communicate shapes what others hear.</p><p class=\"tt-hero-meta\">In person · 1.5–2 hours · 12–18 participants</p><a class=\"tt-button\" href=\"mailto:contact@tujutaju.ee?subject=Six%20languages%20workshop\">Ask about this workshop</a></div><figure class=\"tt-hero-photo\"><img src=\"https://tujutaju.ee/wp-content/uploads/2026/10/workshop-six-keys-20261005.jpg\" alt=\"Six colourful keys representing the six languages of communication\" width=\"675\" height=\"675\"></figure></div></div></section>\n<section class=\"tt-experience\"><div class=\"tt-container\"><div class=\"tt-experience-panel\"><div class=\"tt-experience-intro\"><p class=\"tt-kicker\">How it works</p><h2 class=\"tt-section-title\">Less lecture. More discovery.</h2><p>A short introduction gives the group just enough PCM to begin. Then everyone gets to try six ways of noticing and expressing a message. The difference becomes easier to understand when you experience it yourself.</p></div><div class=\"tt-experience-list\"><div class=\"tt-experience-item\"><span class=\"tt-experience-num\" aria-hidden=\"true\">01</span><div><h3>Try the six perspectives</h3><p>Move through a series of light, practical rounds. Each one invites a different way of looking at and describing a familiar topic.</p></div></div><div class=\"tt-experience-item\"><span class=\"tt-experience-num\" aria-hidden=\"true\">02</span><div><h3>Notice what changes</h3><p>Some ways of speaking come easily. Others take more effort. Compare how the same message sounds when its focus shifts.</p></div></div><div class=\"tt-experience-item\"><span class=\"tt-experience-num\" aria-hidden=\"true\">03</span><div><h3>Connect it to real conversations</h3><p>Reflect together on what you noticed and where those differences show up with colleagues, clients and people close to you.</p></div></div></div></div></div></section>\n<section class=\"tt-discover\"><div class=\"tt-container\"><p class=\"tt-kicker\">What participants take away</p><h2 class=\"tt-section-title\">One message can meet people in different ways</h2><div class=\"tt-discover-grid\"><article class=\"tt-discover-card\"><h3>A clearer sense of your own preferences</h3><p>Notice which ways of communicating come naturally to you, and which ones ask for a conscious change of perspective.</p></article><article class=\"tt-discover-card\"><h3>More curiosity about other people</h3><p>See how the details one person notices first may be quite different from what matters to someone else.</p></article><article class=\"tt-discover-card\"><h3>More options in a conversation</h3><p>When repeating the same message is not helping, changing how you express it can open a new point of connection.</p></article></div></div></section>\n<section class=\"tt-details\"><div class=\"tt-container\"><div class=\"tt-details-grid\"><div><p class=\"tt-kicker\">The format</p><h2 class=\"tt-section-title\">A practical session for your group</h2><img class=\"tt-details-photo\" src=\"https://tujutaju.ee/wp-content/uploads/2026/10/about-pcm-workshop-20261005.webp\" alt=\"Participants practising communication together at Maia's workshop\" width=\"1206\" height=\"795\" loading=\"lazy\"></div><div class=\"tt-details-copy\"><p>This workshop is for teams, leaders, teachers, professional communities and groups of friends who want to share the experience. No prior knowledge of Process Communication Model® is needed.</p><p>I choose familiar, low-pressure topics that suit your group, so participants can focus on the way they communicate rather than on solving a difficult scenario. The atmosphere stays lively and thoughtful, with time to compare observations afterwards.</p><div class=\"tt-details-facts\"><div class=\"tt-fact\"><strong>1.5–2 hours</strong><span>Time for practice and reflection</span></div><div class=\"tt-fact\"><strong>12–18 people</strong><span>A group size for active participation</span></div><div class=\"tt-fact\"><strong>In person</strong><span>In Tallinn or on site across Estonia</span></div><div class=\"tt-fact\"><strong>ET · EN · RU</strong><span>Available in Estonian, English or Russian</span></div></div></div></div></div></section>\n<section class=\"tt-next\"><div class=\"tt-container\"><div class=\"tt-next-panel\"><div><p class=\"tt-kicker\">A first experience of PCM</p><h2 class=\"tt-section-title\">A beginning you can experience</h2></div><div class=\"tt-next-copy\"><p>This is a focused introduction, with space to experiment and notice differences in real time. It is not the full PCM training programme and does not include a personal profile.</p><p>If your group wants to go further afterwards, you can explore <a href=\"https://tujutaju.ee/pcm/\">how PCM works</a> and the <a href=\"https://tujutaju.ee/trainings/\">training formats</a>. The workshop also stands on its own as a useful shared experience.</p></div></div></div></section>\n<section class=\"tt-cta\"><div class=\"tt-container\"><div class=\"tt-cta-panel\"><div><h2 class=\"tt-section-title\">Bring the six languages<br>to your group</h2></div><div class=\"tt-cta-copy\"><p>Tell me who will join and what kind of group you have.</p><p>We can choose the right setting</p><p>and adapt the examples to make the session relevant to your people.</p><a class=\"tt-button\" href=\"https://calendly.com/tujutaju/free-pcm-intro-call\">Book a free 20-minute call</a></div></div></div></section>\n</main>\n</div>\n","_css_classes":"workshop-production-html"},"elements":[]}]
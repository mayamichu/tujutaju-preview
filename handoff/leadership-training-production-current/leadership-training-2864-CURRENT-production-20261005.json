[{"id":"leadship1","elType":"widget","widgetType":"html","isInner":false,"settings":{"html":"<style>@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@600;\n.tt-leadership-page 700&family=Source+Sans+3:wght@400;600&display=swap');\n:root{--blue:#626E98;--soft-blue:#EBECF2;--pink:#EEBCBC;--soft-pink:#FFF0F4;--yellow:#FFE193;--soft-yellow:#FFF4D662;--white:#fff;--max:1160px}\n.tt-leadership-page *{box-sizing:border-box} .tt-leadership-page{margin:0;background:#fff;color:var(--blue);font-family:\"Source Sans 3\",Arial,sans-serif;font-size:17px;line-height:1.48}\n.tt-leadership-page .wrap{width:min(var(--max),calc(100% - 80px));margin:auto}.tt-leadership-page .kicker{font-family:Poppins,sans-serif;font-size:18px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin:0 0 10px}\n.tt-leadership-page h1,.tt-leadership-page h2,.tt-leadership-page h3{font-family:Poppins,sans-serif;margin:0;color:var(--blue)} .tt-leadership-page h1{font-size:clamp(42px,5vw,64px);line-height:1.08;max-width:760px} .tt-leadership-page h2{font-size:clamp(32px,3.6vw,44px);line-height:1.14} .tt-leadership-page h3{font-size:23px;line-height:1.28}\n.tt-leadership-page p{margin:0}.tt-leadership-page .btn{display:inline-flex;align-items:center;justify-content:center;padding:13px 22px;border-radius:0 20px 20px 20px;background:var(--yellow);color:#fff;font-family:Poppins,sans-serif;font-size:14px;font-weight:700;text-decoration:none}\n.tt-leadership-page section{padding:54px 0}.tt-leadership-page .hero{padding:76px 0 62px}.tt-leadership-page .hero-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:68px;align-items:end}.tt-leadership-page .hero .lead{font-size:20px;max-width:760px;margin-top:18px}.tt-leadership-page .meta{margin:26px 0 28px;font-weight:600}.tt-leadership-page .meta-stacked{display:grid;gap:6px}.tt-leadership-page .meta-row{display:flex;flex-wrap:wrap;gap:6px 10px;align-items:center}.tt-leadership-page .meta-row .dot{opacity:.7}\n.tt-leadership-page .hero-art{min-height:440px;position:relative}.tt-leadership-page .shape{position:absolute;border-radius:64px}.tt-leadership-page .shape.a{width:72%;height:58%;right:0;top:0;background:var(--soft-blue);border-radius:64px 0 64px 64px}.tt-leadership-page .shape.b{width:52%;height:40%;left:0;bottom:0;background:var(--soft-yellow);border-radius:0 56px 56px 56px}.tt-leadership-page .shape.c{width:34%;height:30%;right:10%;bottom:6%;background:var(--soft-pink);border-radius:48px 48px 0 48px}.tt-leadership-page .shape span{position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:20px;font-family:Poppins,sans-serif;font-size:15px}\n.tt-leadership-page .blue-band{background:var(--soft-blue)}.tt-leadership-page .leadership-copy{display:grid;gap:16px}.tt-leadership-page .intro-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:74px;align-items:start}\n.tt-leadership-page .learn-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:34px 56px;margin-top:34px}.tt-leadership-page .learn-item{padding-top:18px;border-top:2px solid rgba(98,110,152,.18)}.tt-leadership-page .learn-item:nth-child(1) h3{color:var(--pink)}.tt-leadership-page .learn-item:nth-child(2) h3{color:var(--yellow)}.tt-leadership-page .learn-item:nth-child(3) h3{color:var(--blue)}.tt-leadership-page .learn-item:nth-child(4) h3{color:var(--pink)}.tt-leadership-page .learn-item p{margin-top:9px}\n.tt-leadership-page .profile{background:var(--soft-pink)}.tt-leadership-page .profile-grid{display:grid;grid-template-columns:.88fr 1.12fr;gap:70px;align-items:start}.tt-leadership-page .profile-editorial{padding-top:6px}.tt-leadership-page .profile-editorial>p{font-size:18px;max-width:700px}.tt-leadership-page .profile-list{display:grid;grid-template-columns:1fr 1fr;gap:0 34px;margin-top:28px}.tt-leadership-page .profile-list div{padding:16px 0;border-top:1px solid rgba(98,110,152,.28)}.tt-leadership-page .profile-list strong{font-family:Poppins,sans-serif;font-size:18px;line-height:1.3}\n.tt-leadership-page .process-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:18px;margin-top:32px}.tt-leadership-page .step{padding:24px 18px 26px;border-top:5px solid var(--blue)}.tt-leadership-page .step:nth-child(2){border-color:var(--pink)}.tt-leadership-page .step:nth-child(3){border-color:var(--yellow)}.tt-leadership-page .step:nth-child(4){border-color:var(--blue)}.tt-leadership-page .step:nth-child(5){border-color:var(--pink)}.tt-leadership-page .step .n{font-family:Poppins,sans-serif;font-weight:700;font-size:14px;margin-bottom:12px}.tt-leadership-page .follow-note{margin-top:18px;max-width:860px;font-style:italic}\n.tt-leadership-page .school-grid{display:grid;grid-template-columns:.82fr 1.18fr;gap:72px;align-items:start}.tt-leadership-page .school h2{color:var(--pink)}.tt-leadership-page .school-note{font-size:20px;margin-top:20px;max-width:720px}.tt-leadership-page .school-copy p+p{margin-top:16px}\n.tt-leadership-page .format{background:var(--soft-blue)}.tt-leadership-page .format-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:72px}.tt-leadership-page .facts{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.tt-leadership-page .fact{background:#fff;padding:24px;border-radius:30px}.tt-leadership-page .fact strong{display:block;font-family:Poppins,sans-serif;font-size:22px;margin-bottom:5px}\n.tt-leadership-page .outcomes-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:30px}.tt-leadership-page .outcome{padding-top:16px;border-top:2px solid rgba(98,110,152,.18)}\n.tt-leadership-page .cta{padding-top:24px;padding-bottom:60px}.tt-leadership-page .cta-panel{background:var(--soft-yellow);padding:42px 46px;border-radius:60px 60px 0 60px;display:grid;grid-template-columns:.9fr 1.1fr;gap:70px;align-items:end}.tt-leadership-page .cta-right{display:grid;gap:24px;justify-items:start}\n@media(max-width:900px){.tt-leadership-page .hero-grid,.tt-leadership-page .intro-grid,.tt-leadership-page .profile-grid,.tt-leadership-page .school-grid,.tt-leadership-page .format-grid,.tt-leadership-page .cta-panel{grid-template-columns:1fr}.tt-leadership-page .hero-art{min-height:280px}.tt-leadership-page .process-grid{grid-template-columns:repeat(2,1fr)}.tt-leadership-page .profile-list{grid-template-columns:1fr 1fr}.tt-leadership-page .outcomes-grid{grid-template-columns:1fr}.tt-leadership-page .wrap{width:min(var(--max),calc(100% - 80px))}}\n@media(max-width:620px){.tt-leadership-page .wrap{width:min(var(--max),calc(100% - 32px))}.tt-leadership-page section{padding:42px 0}.tt-leadership-page .hero{padding-top:48px}.tt-leadership-page .learn-grid,.tt-leadership-page .profile-list,.tt-leadership-page .process-grid,.tt-leadership-page .facts{grid-template-columns:1fr}.tt-leadership-page .hero-art{min-height:230px}.tt-leadership-page .cta-panel{padding:32px 26px;border-radius:42px 42px 0 42px}}\n.tt-leadership-page .hero h1{color:#FFE193}\n.tt-leadership-page .hero-grid>div,.tt-leadership-page .intro-grid>div,.tt-leadership-page .profile-grid>div,.tt-leadership-page .school-grid>div,.tt-leadership-page .format-grid>div,.tt-leadership-page .cta-panel>div{min-width:0}\n@media (min-width:621px) and (max-width:900px) and (orientation:landscape){\n.tt-leadership-page .wrap{width:min(var(--max),calc(100% - 48px))}\n.tt-leadership-page .hero-grid{grid-template-columns:minmax(0,1.1fr) minmax(220px,.9fr);gap:26px}\n.tt-leadership-page .hero-art{min-height:250px}\n.tt-leadership-page .intro-grid,.tt-leadership-page .profile-grid,.tt-leadership-page .school-grid,.tt-leadership-page .format-grid,.tt-leadership-page .cta-panel{grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:28px}\n.tt-leadership-page .process-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}\n.tt-leadership-page .outcomes-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}\n.tt-leadership-page .cta-panel{padding:32px 28px}}</style>\n<div class=\"tt-leadership-page\"><section class=\"hero\"><div class=\"wrap hero-grid\"><div><p class=\"kicker\">PCM Leadership Training</p><h1>Understand different people. Lead with more choice.</h1><p class=\"lead\">A practical 16-hour Process Communication Model® programme for leaders who want to understand what motivates different people, recognise stress earlier and adapt communication to real people and real situations.</p><div class=\"meta meta-stacked\">\n  <div class=\"meta-row\"><span>16 hours</span><span class=\"dot\">·</span><span>Personal Leadership Profile</span><span class=\"dot\">·</span><span>In person</span></div>\n  <div class=\"meta-row\"><span>ET</span><span class=\"dot\">·</span><span>EN</span><span class=\"dot\">·</span><span>RU</span></div>\n</div><a class=\"btn\" href=\"https://calendly.com/tujutaju/free-pcm-intro-call\">Book a 20-minute introduction call</a></div><div class=\"hero-art\" aria-label=\"Abstract leadership visual about communication, motivation and stress\"><div class=\"shape a\"><span>leadership<br>communication</span></div><div class=\"shape b\"><span>motivation</span></div><div class=\"shape c\"><span>stress</span></div></div></div></section>\n\n<section class=\"blue-band\"><div class=\"wrap intro-grid\"><div><p class=\"kicker\">Leadership through PCM</p><h2>Different people need different ways of being led.</h2></div><div class=\"leadership-copy\">\n  <p>PCM gives leaders a practical framework for understanding personality differences, psychological needs, motivation and behaviour under stress.</p>\n  <p>It also starts with the leader: understanding your own strengths, preferred ways of leading, reactions under stress and patterns you may not notice as quickly in yourself.</p>\n  <p>The goal is not to learn one “correct” leadership style, but to recognise what is happening — in yourself and in others — and choose a way of communicating that fits the person and the situation.</p>\n</div></div></section>\n\n<section><div class=\"wrap\"><p class=\"kicker\">What participants learn</p><h2>From understanding people to leading them more consciously</h2><div class=\"learn-grid\">\n<div class=\"learn-item\"><h3>Recognise people faster</h3><p>Notice communication clues, personality preferences and the first signs that contact is becoming more difficult.</p></div>\n<div class=\"learn-item\"><h3>Motivate more precisely</h3><p>Understand different psychological needs and choose ways of communicating that support motivation and engagement.</p></div>\n<div class=\"learn-item\"><h3>Return communication to a constructive track</h3><p>Recognise early stress and misunderstanding, adapt your approach and reduce the risk of escalation.</p></div>\n<div class=\"learn-item\"><h3>Understand yourself as a leader</h3><p>See your own strengths, preferred leadership patterns, stress responses and ways to stay more effective in difficult situations.</p></div>\n</div></div></section>\n\n<section class=\"profile\"><div class=\"wrap profile-grid\"><div><p class=\"kicker\">Your Leadership Profile</p><h2>Your own communication is part of the leadership system.</h2></div><div class=\"profile-editorial\"><p>Before the training, each participant completes the official PCM questionnaire and receives a personal Leadership Profile. It connects the model directly to your own communication, motivation, interaction preferences and patterns under stress.</p><div class=\"profile-list editorial-list\"><div><strong>Personality Structure & strengths</strong></div><div><strong>Communication & interaction preferences</strong></div><div><strong>Psychological needs & motivation</strong></div><div><strong>Stress patterns & practical reflection</strong></div></div></div></div></section>\n\n<section><div class=\"wrap\"><p class=\"kicker\">How the training works</p><h2>Learn it. Notice it. Try it in real life.</h2><div class=\"process-grid process-five\">\n<div class=\"step\"><div class=\"n\">01</div><h3>Profile</h3><p>Start with your personal PCM Leadership Profile.</p></div>\n<div class=\"step\"><div class=\"n\">02</div><h3>Understand</h3><p>Build a shared language for personality, motivation and stress.</p></div>\n<div class=\"step\"><div class=\"n\">03</div><h3>Practise</h3><p>Work individually, in pairs and in groups with practical exercises and cases.</p></div>\n<div class=\"step\"><div class=\"n\">04</div><h3>Apply</h3><p>Use the time between sessions to notice patterns in everyday work and try new approaches in real situations.</p></div>\n<div class=\"step follow-up\"><div class=\"n\">05</div><h3>Follow up</h3><p>Meet again after the training to discuss what happened in practice, ask questions and refine how PCM is used in everyday work.</p></div>\n</div><p class=\"follow-note\">The goal is not to finish the training and leave the profile on a shelf. Follow-up helps turn PCM into an everyday working tool.</p></div></section>\n\n<section class=\"school\"><div class=\"wrap school-grid\"><div><p class=\"kicker\">For schools & education</p><h2>A teacher is a leader, too.</h2><p class=\"school-note\">PCM Leadership Training can be used in schools for teachers and school leaders, without turning it into a separate “school version” of the model.</p></div><div class=\"school-copy\"><p>A teacher leads every day: creates a frame, guides learning, motivates, keeps a group together and adapts communication to different people and situations.</p><p>PCM gives schools a shared language for understanding what motivates different students, how they take in information, how stress changes behaviour and communication, and what can help restore contact.</p><p>For experienced teachers, much of this may already happen intuitively. PCM helps make that knowledge more conscious, easier to discuss and easier to use consistently across a school team.</p></div></div></section>\n\n<section class=\"format\"><div class=\"wrap format-grid\"><div><p class=\"kicker\">Format</p><h2>16 hours with time to apply what you learn</h2></div><div class=\"facts\">\n<div class=\"fact\"><strong>4 × 4 hours</strong><span>Four meetings with space between them for real-life observation and practice.</span></div>\n<div class=\"fact\"><strong>In person</strong><span>For organisations, teams and schools.</span></div>\n<div class=\"fact\"><strong>ET · EN · RU</strong><span>The training can be delivered in Estonian, English or Russian.</span></div>\n<div class=\"fact\"><strong>Practical by design</strong><span>Theory, individual work, pair/group exercises, video analysis and real group cases.</span></div>\n</div></div></section>\n\n<section><div class=\"wrap\"><p class=\"kicker\">What changes after the training</p><h2>More options in the moments that matter</h2><div class=\"outcomes-grid\">\n<div class=\"outcome\"><h3>Clearer communication</h3><p>More choice in how you explain, direct, give feedback and build trust with different people.</p></div>\n<div class=\"outcome\"><h3>Earlier recognition of stress</h3><p>Notice when communication starts to move off track and respond before tension grows.</p></div>\n<div class=\"outcome\"><h3>More conscious motivation</h3><p>Understand what different people need in order to stay engaged, resourceful and able to contribute.</p></div>\n</div></div></section>\n\n<section class=\"cta\"><div class=\"wrap\"><div class=\"cta-panel\"><div><p class=\"kicker\">PCM Leadership Training</p><h2>Bring a shared language for leadership to your organisation.</h2></div><div class=\"cta-right\"><p>Tell me about your team, organisation or school. We can look at the context and choose the right way to run the training.</p><a class=\"btn\" href=\"https://calendly.com/tujutaju/free-pcm-intro-call\">Book a 20-minute introduction call</a></div></div></div></section></div>"},"elements":[]}]
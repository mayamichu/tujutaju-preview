[{"id":"spt28710","elType":"widget","settings":{"html":"<style>\n#tt-spt-page{--blue:#626E98;--pink:#EEBCBC;--yellow:#FFE193;--soft-blue:#EBECF2;--soft-pink:#FFF0F4;--soft-yellow:#FFF4D6;--white:#FFFFFF;--hover-pink:#FFD3DE;color:var(--blue,#626E98);background:var(--white,#FFFFFF);font-family:\"Source Sans 3\",Arial,sans-serif;font-size:17px;font-weight:400;line-height:1.68}\n#tt-spt-page,#tt-spt-page *{box-sizing:border-box}\n#tt-spt-page .tt-container{width:min(1160px,calc(100% - 48px));margin-inline:auto}\n#tt-spt-page .tt-kicker{margin:0 0 12px;font-family:Poppins,sans-serif;font-size:16px;font-weight:700;line-height:1.4;letter-spacing:.08em;text-transform:uppercase;color:var(--blue,#626E98)}\n#tt-spt-page .tt-title,#tt-spt-page h2,#tt-spt-page h3{font-family:Poppins,sans-serif;font-weight:700}\n#tt-spt-page .tt-title{margin:0;font-size:clamp(36px,4.5vw,54px);line-height:1.18;color:var(--blue,#626E98)}\n#tt-spt-page .tt-body{color:var(--blue,#626E98);font-family:\"Source Sans 3\",Arial,sans-serif;font-size:17px;font-weight:400;line-height:1.68}\n#tt-spt-page .tt-body p{margin:0 0 16px}\n#tt-spt-page .tt-body p:last-child{margin:0}\n#tt-spt-page .tt-button{display:inline-flex;align-items:center;justify-content:center;padding:13px 22px;border-radius:0 18px 18px 18px;background:var(--yellow,#FFE193);color:var(--blue,#626E98);text-decoration:none;font-family:\"Source Sans 3\",Arial,sans-serif;font-size:15px;line-height:1.35;font-weight:600;letter-spacing:0;text-transform:none;transition:background .2s,transform .2s}\n#tt-spt-page .tt-button:hover{background:var(--hover-pink,#FFD3DE);transform:translateY(-2px)}\n#tt-spt-page a:focus-visible{outline:3px solid #485579;outline-offset:4px}\n#tt-spt-page .tt-hero{padding:64px 0 48px;background:var(--white,#FFFFFF)}\n#tt-spt-page .tt-hero-inner{max-width:880px}\n#tt-spt-page .tt-hero .tt-body{max-width:780px;margin-top:24px;font-size:18px}\n#tt-spt-page .tt-hero .tt-body p{margin-bottom:14px}\n#tt-spt-page .tt-back{display:inline-block;margin:0 0 28px;color:var(--blue,#626E98);text-underline-offset:4px;font-size:15px}\n#tt-spt-page .tt-types{padding:0 0 58px;background:var(--white,#FFFFFF)}\n#tt-spt-page .tt-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}\n#tt-spt-page .tt-card{--accent:#626E98;--wash:#EBECF2;display:grid;grid-template-columns:38% minmax(0,1fr);gap:20px;min-width:0;min-height:340px;padding:28px 28px 26px;background:var(--wash,#EBECF2);border-radius:0 52px 52px 52px;scroll-margin-top:24px}\n#tt-spt-page .tt-card:nth-child(even){border-radius:52px 0 52px 52px}\n#tt-spt-page .tt-card--thinker{--accent:#2589d8;--wash:#eaf5fe}\n#tt-spt-page .tt-card--persister{--accent:#7f379d;--wash:#f4edf8}\n#tt-spt-page .tt-card--harmonizer{--accent:#ed7007;--wash:#fff1e5}\n#tt-spt-page .tt-card--rebel{--accent:#FAE200;--wash:#fff9db}\n#tt-spt-page .tt-card--promoter{--accent:#d91b37;--wash:#fff0f1}\n#tt-spt-page .tt-card--imaginer{--accent:#9a644d;--wash:#f5eee9}\n#tt-spt-page .tt-card--rebel .tt-type-number{color:var(--blue,#626E98)}\n#tt-spt-page .tt-art{align-self:end;display:flex;align-items:flex-end;justify-content:center;min-width:0;min-height:278px;margin:0}\n#tt-spt-page .tt-art img{display:block;width:100%;height:278px;object-fit:contain;object-position:center bottom}\n#tt-spt-page .tt-copy{min-width:0;color:var(--blue,#626E98)}\n#tt-spt-page .tt-type-number{margin:0 0 8px;color:var(--accent,#626E98);font-family:Poppins,sans-serif;font-weight:700;font-size:13px;letter-spacing:.08em;text-transform:uppercase}\n#tt-spt-page .tt-copy h2{margin:0 0 13px;color:var(--accent,#626E98);font-size:clamp(25px,2.6vw,32px);line-height:1.2}\n#tt-spt-page .tt-copy p{margin:0 0 16px;line-height:1.62}\n#tt-spt-page .tt-copy h3{margin:0 0 6px;color:var(--blue,#626E98);font-size:16px;line-height:1.4}\n#tt-spt-page .tt-copy ul{margin:0;padding-left:19px;line-height:1.58}\n#tt-spt-page .tt-copy li+li{margin-top:4px}\n#tt-spt-page .tt-copy li::marker{color:var(--accent,#626E98)}\n#tt-spt-page .tt-variety{padding:12px 0 54px;background:var(--white,#FFFFFF)}\n#tt-spt-page .tt-variety-panel{background:transparent;border:0;border-radius:0}\n#tt-spt-page .tt-variety-grid{display:grid;grid-template-columns:minmax(0,1.62fr) minmax(260px,1fr);gap:46px;align-items:center;padding:0}\n#tt-spt-page .tt-variety-head{max-width:760px}\n#tt-spt-page .tt-variety h2{margin:0 0 15px;color:var(--blue,#626E98);font-size:clamp(29px,3.4vw,40px);line-height:1.2}\n#tt-spt-page .tt-variety .tt-body{max-width:800px}\n#tt-spt-page .tt-variety-figure{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0;margin:0;padding:14px}\n#tt-spt-page .tt-variety-image{display:block;width:auto;max-width:100%;max-height:470px;height:auto;object-fit:contain;background:transparent;border-radius:0}\n#tt-spt-page .tt-variety figcaption{max-width:320px;margin-top:10px;font-size:13px;line-height:1.5;text-align:center;color:var(--blue,#626E98)}\n#tt-spt-page .tt-reminder{padding:0 0 38px;background:var(--white,#FFFFFF)}\n#tt-spt-page .tt-reminder-panel{padding:38px 42px 40px;background:var(--soft-yellow,#FFF4D6);border-radius:0 58px 58px 58px}\n#tt-spt-page .tt-reminder h2{margin:0 0 16px;color:var(--blue,#626E98);font-size:clamp(29px,3.4vw,40px);line-height:1.2}\n#tt-spt-page .tt-reminder .tt-body{max-width:860px}\n#tt-spt-page .tt-reminder a:not(.tt-button){color:var(--blue,#626E98);font-weight:600;text-underline-offset:4px}\n#tt-spt-page .tt-reminder .tt-button{margin-top:18px}\n@media(max-width:1000px){\n #tt-spt-page .tt-container{width:calc(100% - 80px)}\n #tt-spt-page .tt-grid{grid-template-columns:1fr}\n #tt-spt-page .tt-card{grid-template-columns:230px minmax(0,1fr);min-height:0}\n #tt-spt-page .tt-art{min-height:260px}\n #tt-spt-page .tt-art img{height:270px}\n #tt-spt-page .tt-variety-grid{grid-template-columns:minmax(0,1.4fr) minmax(220px,1fr);gap:30px}\n #tt-spt-page .tt-variety-image{max-height:430px}\n}\n@media(max-width:900px){\n #tt-spt-page .tt-variety-grid{grid-template-columns:1fr;gap:24px}\n #tt-spt-page .tt-variety-figure{padding:0}\n #tt-spt-page .tt-variety-image{max-height:400px}\n #tt-spt-page .tt-variety figcaption{max-width:100%}\n}\n@media(max-width:650px){\n #tt-spt-page .tt-container{width:calc(100% - 28px)}\n #tt-spt-page .tt-hero{padding:46px 0 36px}\n #tt-spt-page .tt-hero .tt-body{font-size:17px}\n #tt-spt-page .tt-kicker{font-size:15px}\n #tt-spt-page .tt-grid{gap:18px}\n #tt-spt-page .tt-card,#tt-spt-page .tt-card:nth-child(even){grid-template-columns:1fr;padding:24px 22px 28px;border-radius:0 40px 40px 40px;gap:4px}\n #tt-spt-page .tt-art{order:2;min-height:0;margin-top:12px}\n #tt-spt-page .tt-art img{height:250px;max-width:300px}\n #tt-spt-page .tt-copy{order:1}\n #tt-spt-page .tt-types{padding-bottom:38px}\n #tt-spt-page .tt-variety{padding-top:8px;padding-bottom:42px}\n #tt-spt-page .tt-variety-grid{gap:20px}\n #tt-spt-page .tt-variety-image{max-height:360px;width:auto;max-width:100%}\n #tt-spt-page .tt-reminder{padding-bottom:30px}\n #tt-spt-page .tt-reminder-panel{padding:30px 24px 32px;border-radius:0 40px 40px 40px}\n}\n@media(max-width:900px) and (orientation:landscape){\n #tt-spt-page .tt-hero{padding-top:36px;padding-bottom:34px}\n #tt-spt-page .tt-card{grid-template-columns:190px minmax(0,1fr);padding:22px;gap:16px}\n #tt-spt-page .tt-art{min-height:230px}\n #tt-spt-page .tt-art img{height:230px}\n #tt-spt-page .tt-variety-grid{grid-template-columns:1fr;gap:18px}\n #tt-spt-page .tt-variety-image{max-height:260px}\n #tt-spt-page .tt-reminder-panel{padding:28px 30px 30px}\n}\n@media(prefers-reduced-motion:reduce){#tt-spt-page .tt-button{transition:none}}\n<\/style>\n<div class=\"tt-page\" id=\"tt-spt-page\">\n<main>\n<section class=\"tt-hero\"><div class=\"tt-container\"><div class=\"tt-hero-inner\">\n<a class=\"tt-back\" href=\"https:\/\/tujutaju.ee\/pcm\/\">\u2190 Back to PCM<\/a>\n<p class=\"tt-kicker\">Process Communication Model<\/p>\n<h1 class=\"tt-title\">Six Personality Types.<br>All within each of us.<\/h1>\n<div class=\"tt-body\"><p>PCM describes six Personality Types, each with its own strengths, preferences and ways of connecting. We all have all six. What differs is their order and how much energy is available to us in each.<\/p><p>These short descriptions offer a first glimpse of what each type brings and how you can make contact.<\/p><\/div>\n<\/div><\/div><\/section>\n<section class=\"tt-types\" aria-label=\"The six Personality Types\"><div class=\"tt-container\"><div class=\"tt-grid\">\n<article class=\"tt-card tt-card--thinker\" id=\"thinker\"><figure class=\"tt-art\"><img src=\"https:\/\/tujutaju.ee\/wp-content\/uploads\/2026\/09\/PCM_opener_SixCharacters_Thinker-768x1166.png\" alt=\"Illustration of the Thinker Personality Type\" loading=\"eager\"><\/figure><div class=\"tt-copy\"><p class=\"tt-type-number\">01 \/ Six Personality Types<\/p><h2>Thinker<\/h2><p>People with a lot of Thinker energy are responsible and logical. They look for facts and data.<\/p><h3>How to connect with Thinker<\/h3><ul><li>Provide thorough information<\/li><li>Show them you value their work and time<\/li><li>Ask for their ideas<\/li><\/ul><\/div><\/article>\n<article class=\"tt-card tt-card--persister\" id=\"persister\"><figure class=\"tt-art\"><img src=\"https:\/\/tujutaju.ee\/wp-content\/uploads\/2026\/09\/PCM_opener_SixCharacters_Persister-768x970.png\" alt=\"Illustration of the Persister Personality Type\" loading=\"lazy\"><\/figure><div class=\"tt-copy\"><p class=\"tt-type-number\">02 \/ Six Personality Types<\/p><h2>Persister<\/h2><p>People with a lot of Persister energy are dedicated and attentive. They need to be respected for their conviction.<\/p><h3>How to connect with Persister<\/h3><ul><li>Ask for their opinions<\/li><li>Invest in mutual respect<\/li><li>Show them you appreciate their valuable contributions<\/li><\/ul><\/div><\/article>\n<article class=\"tt-card tt-card--harmonizer\" id=\"harmonizer\"><figure class=\"tt-art\"><img src=\"https:\/\/tujutaju.ee\/wp-content\/uploads\/2026\/09\/PCM_opener_SixCharacters_Harmoniser-768x970.png\" alt=\"Illustration of the Harmonizer Personality Type\" loading=\"lazy\"><\/figure><div class=\"tt-copy\"><p class=\"tt-type-number\">03 \/ Six Personality Types<\/p><h2>Harmonizer<\/h2><p>People with a lot of Harmonizer energy are warm and compassionate. They want you to feel good and they need to be appreciated for who they are.<\/p><h3>How to connect with Harmonizer<\/h3><ul><li>Create a pleasant atmosphere<\/li><li>Show that you appreciate him or her<\/li><li>Invite collaboration in a caring setting<\/li><\/ul><\/div><\/article>\n<article class=\"tt-card tt-card--rebel\" id=\"rebel\"><figure class=\"tt-art\"><img src=\"https:\/\/tujutaju.ee\/wp-content\/uploads\/2026\/09\/PCM_opener_SixCharacters_Rebel-768x1374.png\" alt=\"Illustration of the Rebel Personality Type\" loading=\"lazy\"><\/figure><div class=\"tt-copy\"><p class=\"tt-type-number\">04 \/ Six Personality Types<\/p><h2>Rebel<\/h2><p>People with a lot of Rebel energy are spontaneous and creative. They bring energy and like to try something new.<\/p><h3>How to connect with Rebel<\/h3><ul><li>Keep it playful and use humor<\/li><li>Allow room for new ideas and experiences<\/li><li>Be open to spontaneous reactions<\/li><\/ul><\/div><\/article>\n<article class=\"tt-card tt-card--promoter\" id=\"promoter\"><figure class=\"tt-art\"><img src=\"https:\/\/tujutaju.ee\/wp-content\/uploads\/2026\/09\/PCM_opener_SixCharacters_Promoter-768x678.png\" alt=\"Illustration of the Promoter Personality Type\" loading=\"lazy\"><\/figure><div class=\"tt-copy\"><p class=\"tt-type-number\">05 \/ Six Personality Types<\/p><h2>Promoter<\/h2><p>People with a lot of Promoter energy are direct and charming. They always find a way to make things happen.<\/p><h3>How to connect with Promoter<\/h3><ul><li>Skip the small talk and get straight to business<\/li><li>Challenge them with promising initiatives<\/li><li>Offer them the opportunity to shine<\/li><\/ul><\/div><\/article>\n<article class=\"tt-card tt-card--imaginer\" id=\"imaginer\"><figure class=\"tt-art\"><img src=\"https:\/\/tujutaju.ee\/wp-content\/uploads\/2026\/09\/PCM_opener_SixCharacters_Dreamer-768x820.png\" alt=\"Illustration of the Imaginer Personality Type\" loading=\"lazy\"><\/figure><div class=\"tt-copy\"><p class=\"tt-type-number\">06 \/ Six Personality Types<\/p><h2>Imaginer<\/h2><p>People with a lot of Imaginer energy are imaginative and calm. They need to take their time to reflect and to ponder concepts.<\/p><h3>How to connect with Imaginer<\/h3><ul><li>Provide them time and space<\/li><li>Give clear instructions<\/li><li>Appeal to their imagination<\/li><\/ul><\/div><\/article>\n<\/div><\/div><\/section>\n<section class=\"tt-variety\" aria-labelledby=\"variety-title\"><div class=\"tt-container\"><div class=\"tt-variety-panel tt-variety-grid\"><div class=\"tt-variety-head\"><p class=\"tt-kicker\">Personality structure<\/p><h2 id=\"variety-title\">The same six types.<br>So many different structures.<\/h2><div class=\"tt-body\"><p>The colours in each little stack are the same six Personality Types. Change their order, and there are already 720 possible arrangements. In real life, the amount of energy in each type varies too \u2014 making each person\u2019s Personality Structure their own.<\/p><p>One of these little stacks follows the same order as yours. Once you have your PCM Profile, you can find it!<\/p><\/div><\/div><figure class=\"tt-variety-figure\"><img class=\"tt-variety-image\" src=\"https:\/\/tujutaju.ee\/wp-content\/uploads\/2026\/10\/A4.webp\" width=\"1200\" height=\"1698\" loading=\"lazy\" alt=\"Diagram showing 720 possible arrangements of the same six Personality Types\"><figcaption>720 possible orders of six Personality Types, shown here as coloured stacks.<\/figcaption><\/figure><\/div><\/div><\/section>\n<section class=\"tt-reminder\"><div class=\"tt-container\"><div class=\"tt-reminder-panel\"><p class=\"tt-kicker\">One personality, six types<\/p><h2>There are no \u201ctypes of people\u201d here.<\/h2><div class=\"tt-body\"><p>These are Personality Types within people. Each of us has a unique Personality Structure, and no type is better than another. Recognising the differences can help us choose a way of communicating that reaches the person in front of us.<\/p><p>You can read more about the model on the <a href=\"https:\/\/tujutaju.ee\/pcm\/\">PCM page<\/a>.<\/p><\/div><a class=\"tt-button\" href=\"https:\/\/tujutaju.ee\/consultations\/\">Explore your Personality Structure<\/a><\/div><\/div><\/section>\n<\/main>\n\n<\/div>\n"},"elements":[],"widgetType":"html"}]
-next-card p{margin:0 0 22px;line-height:1.65}.tt-next-card .tt-button{align-self:flex-start;margin-top:0}.tt-next-card:first-child h3{color:var(--tt-pink)}.tt-next-card:last-child h3{color:var(--tt-yellow)}.tt-next-card:first-child .tt-button{background:var(--tt-pink);color:var(--tt-blue)}.tt-next-card:last-child .tt-button{background:var(--tt-yellow);color:var(--tt-blue)}\n\n\n@media(max-width:950px){.tt-step-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media(max-width:850px){.tt-container{width:min(100% - 32px,1160px)}.tt-intro-grid{grid-template-columns:1fr;grid-template-areas:\"hero\" \"people\" \"types\";gap:34px}.tt-hero-copy{padding-top:0}.tt-people{width:min(82%,505px)}.tt-origin-panel,.tt-research-top{grid-template-columns:1fr;gap:32px}.tt-title{font-size:42px}.tt-section-title{font-size:34px}.tt-origin .tt-section-title{white-space:normal}.tt-origin-panel,.tt-research-panel{padding:34px 32px 38px}.tt-types-copy{padding-bottom:0;transform:none}.tt-origin-panel{row-gap:16px}}\n@media(max-width:620px){.tt-next-grid,.tt-stats{grid-template-columns:1fr}.tt-history{grid-template-columns:1fr}.tt-history-item{min-height:0}}\n@media(max-width:520px){.tt-container{width:min(100% - 28px,1160px)}.tt-intro{padding-top:50px}.tt-title{font-size:34px}.tt-section-title{font-size:30px}.tt-hero-lead{font-size:16px}.tt-people{width:min(94%,505px)}.tt-origin-panel,.tt-research-panel{padding:30px 24px 34px;border-radius:0 42px 42px 42px}.tt-research-panel{border-radius:42px 0 42px 42px}.tt-step-grid{grid-template-columns:1fr}.tt-step{min-height:0}.tt-next-card{padding:30px 24px;border-radius:42px 42px 42px 0}.tt-next-card:last-child{border-radius:42px 42px 0 42px}}\n\n@media(min-width:621px) and (max-width:850px) and (min-height:501px) and (orientation:portrait){\n.tt-container{width:calc(100vw - 80px);max-width:none}\n.tt-intro-grid{grid-template-columns:minmax(0,1fr) minmax(250px,.9fr);grid-template-areas:\"hero people\" \"types people\";column-gap:24px;row-gap:66px;align-items:start}\n.tt-hero-copy{padding:0}.tt-people{position:relative;z-index:1;width:min(calc(100% + 45px),390px);height:100%;align-self:stretch;justify-self:end}.tt-people-link{height:100%;padding-top:45px}.tt-people img{height:calc(100% - 56px);width:100%;object-fit:contain;object-position:top center}.tt-hero-copy,.tt-types-copy{position:relative;z-index:2}\n.tt-types-copy{align-self:start;transform:none}\n}\n@media(min-width:621px) and (max-width:950px) and (max-height:500px) and (orientation:landscape){\n.tt-intro-grid{grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);grid-template-areas:\"hero people\" \"types people\";column-gap:32px;row-gap:22px}\n.tt-people{width:min(100%,400px)}\n.tt-origin-panel{grid-template-columns:minmax(0,1.15fr) minmax(280px,.85fr);column-gap:24px}\n.tt-research-top{grid-template-columns:minmax(0,1fr) minmax(300px,.8fr);gap:24px}\n}\n\n\n@media(max-width:520px) and (orientation:portrait){\n.tt-hero-copy{text-align:right}.tt-hero-copy>.tt-kicker span{display:block}\n.tt-next-head{margin-bottom:66px}.tt-next-grid{gap:66px}\n\n}\n@media(min-width:621px) and (max-width:950px) and (max-height:500px) and (orientation:landscape){\n.tt-intro{padding-top:94px}.tt-intro-grid{grid-template-columns:minmax(0,1fr) 220px;grid-template-areas:\"hero people\" \"types types\";column-gap:24px;row-gap:20px;align-items:start}\n.tt-hero-copy{padding:0}.tt-people{width:100%;height:auto;align-self:start}.tt-types-copy{transform:none;max-width:100%}\n\n}\n\n/* Narrow repair: content-sized Hero rows keep grid/image height out of the text gap. */\n@media(min-width:851px){\n.tt-intro-grid{grid-template-rows:max-content max-content}\n.tt-hero-copy .tt-title{width:max-content;max-width:none}\n.tt-people{width:min(100%,420px);justify-self:end}\n}\n@media(min-width:621px) and (max-width:850px) and (min-height:501px) and (orientation:portrait){\n.tt-intro-grid{grid-template-rows:max-content max-content}\n.tt-hero-copy .tt-title{width:calc(100% + 54px);max-width:none}\n}\n@media(max-width:620px){.tt-desktop-break{display:none}}\n@media(min-width:621px) and (max-width:950px) and (max-height:500px) and (orientation:landscape){\n.tt-desktop-break{display:none}.tt-intro-grid{grid-template-rows:auto auto}\n}\n\n</style>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"name\":\"What is the Process Communication Model (PCM)?\",\"url\":\"https://tujutaju.ee/pcm/\",\"description\":\"An introduction to the Process Communication Model, its origins, six Personality Types and practical communication framework.\",\"mainEntity\":{\"@type\":\"DefinedTerm\",\"name\":\"Process Communication Model\",\"alternateName\":\"PCM\",\"description\":\"A practical framework for understanding personality differences and adapting communication.\"}}</script>\n<div class=\"tt-page\">\n<main>\n<section class=\"tt-intro\" id=\"six-types\">\n<div class=\"tt-container\"><div class=\"tt-intro-grid\">\n<div class=\"tt-hero-copy\">\n<p class=\"tt-kicker\"><span>Process</span><span>Communication Model</span></p>\n<h1 class=\"tt-title\">A practical model<br class=\"tt-desktop-break\"> for understanding<br class=\"tt-desktop-break\"> how people communicate.</h1>\n<p class=\"tt-hero-lead\">Process Communication Model® (PCM) explains how people perceive the world, communicate, stay motivated and respond under stress. It helps us recognise individual differences and adapt the way we connect — without putting people into boxes.</p>\n</div>\n<figure class=\"tt-people\">\n<a class=\"tt-people-link\" href=\"/six-personality-types/\" aria-label=\"Explore the six PCM Personality Types\">\n<img src=\"https://tujutaju.ee/wp-content/uploads/2026/09/pcm-six-ptypes-together-505x1024.webp\" srcset=\"https://tujutaju.ee/wp-content/uploads/2026/09/pcm-six-ptypes-together-505x1024.webp 505w, https://tujutaju.ee/wp-content/uploads/2026/09/pcm-six-ptypes-together-768x1556.webp 768w, https://tujutaju.ee/wp-content/uploads/2026/09/pcm-six-ptypes-together.webp 990w\" sizes=\"(max-width: 850px) 82vw, 505px\" width=\"505\" height=\"1024\" alt=\"Six illustrated people representing the six PCM Personality Types\">\n\n</a>\n</figure>\n<div class=\"tt-types-copy\"><p class=\"tt-kicker\">Personality structure</p><h2 class=\"tt-section-title\">One personality.<br>Six Personality Types.</h2><div class=\"tt-body\"><p>PCM does not place people into six separate boxes. It starts from the understanding that all six Personality Types are present in every one of us: <a class=\"tt-pcm-type tt-thinker\" href=\"/six-personality-types/\">Thinker</a>, <a class=\"tt-pcm-type tt-persister\" href=\"/six-personality-types/\">Persister</a>, <a class=\"tt-pcm-type tt-harmonizer\" href=\"/six-personality-types/\">Harmonizer</a>, <a class=\"tt-pcm-type tt-rebel\" href=\"/six-personality-types/\">Rebel</a>, <a class=\"tt-pcm-type tt-promoter\" href=\"/six-personality-types/\">Promoter</a> and <a class=\"tt-pcm-type tt-imaginer\" href=\"/six-personality-types/\">Imaginer</a>. This means we can find a point of connection with each of them in other people.</p><p>Each type brings its own strengths, way of perceiving the world, communication preferences and psychological needs. Their unique order and combination form our individual Personality Structure — which is why the same words, situations and relationships can feel so different to different people.</p><p>No type is better than another. PCM helps us recognise these differences and communicate in ways that are easier for others to understand.</p></div><a class=\"tt-button tt-types-link\" href=\"/six-personality-types/\" aria-label=\"Explore the six Personality Types\">Explore the six Personality Types</a></div>\n</div></div>\n</section>\n\n<section class=\"tt-origin\">\n<div class=\"tt-container\"><div class=\"tt-origin-panel\">\n<div><p class=\"tt-kicker\">The story behind the model</p><h2 class=\"tt-section-title\">Where PCM came from</h2><div class=\"tt-history\"><div class=\"tt-history-item\"><strong>1970s</strong><span>Dr Kahler identifies observable patterns.</span></div><div class=\"tt-history-item\"><strong>Late 1970s</strong><span><b>NASA</b> applies Kahler’s insights to astronaut selection.</span></div><div class=\"tt-history-item\"><strong>1982</strong><span>Process Communication Model® is formally created.</span></div></div></div>\n<div class=\"tt-body\"><p>Process Communication Model® was developed by American clinical psychologist Dr Taibi Kahler in the 1970s. Through his research, he identified recurring and observable patterns in the way people communicate — and in how their behaviour changes under stress.</p><p>In the late 1970s, Dr Kahler applied these insights to help NASA select astronauts for missions. In 1982, he validated the Personality Pattern Inventory and formally created PCM: a practical framework for understanding personality differences and making communication more effective.</p></div>\n<p class=\"tt-origin-clinton\">In 1984, Hillary Clinton invited Dr Kahler to give a private three-day PCM seminar to Bill Clinton, then Governor of Arkansas, and a small group close to them. Dr Kahler later advised Clinton on connecting with different audiences and reviewed speeches during his presidential campaign.</p>\n</div></div>\n</section>\n\n<section class=\"tt-works\">\n<div class=\"tt-container\">\n<div class=\"tt-works-head\"><p class=\"tt-kicker\">A practical framework</p><h2 class=\"tt-section-title\">How PCM works</h2></div>\n<div class=\"tt-step-grid\">\n<article class=\"tt-step\"><div class=\"tt-step-visual\"><img src=\"https://tujutaju.ee/wp-content/uploads/2026/09/pcm-how-it-works-02.webp\" width=\"1239\" height=\"2048\" loading=\"lazy\" alt=\"\"></div><h3>Be aware of your personality</h3><p>Understanding your preferences means knowing what energizes you and what ticks you off.</p></article>\n<article class=\"tt-step\"><div class=\"tt-step-visual\"><img src=\"https://tujutaju.ee/wp-content/uploads/2026/09/pcm-how-it-works-04.webp\" width=\"1443\" height=\"2048\" loading=\"lazy\" alt=\"\"></div><h3>Recognize what other people do, say, and show</h3><p>These observations inform you about people’s preferences and the best way to connect.</p></article>\n<article class=\"tt-step\"><div class=\"tt-step-visual\"><img src=\"https://tujutaju.ee/wp-content/uploads/2026/09/pcm-how-it-works-01-1.webp\" width=\"1254\" height=\"2048\" loading=\"lazy\" alt=\"\"></div><h3>Adapt your communication style</h3><p>In order to make a genuine connection that feels good for both of you.</p></article>\n<article class=\"tt-step\"><div class=\"tt-step-visual\"><img src=\"https://tujutaju.ee/wp-content/uploads/2026/09/pcm-how-it-works-03.webp\" width=\"1424\" height=\"2048\" loading=\"lazy\" alt=\"\"></div><h3>Build stronger relationships</h3><p>With everyday interactions, at work and at home, every day.</p></article>\n</div>\n</div>\n</section>\n\n<section class=\"tt-research\">\n<div class=\"tt-container\"><div class=\"tt-research-panel\">\n<div class=\"tt-research-top\"><div><p class=\"tt-kicker\">Established and evolving</p><h2 class=\"tt-section-title\">Grounded in research.<br>Used around the world.</h2></div><div class=\"tt-stats\" aria-label=\"PCM worldwide\"><div class=\"tt-stat\"><strong>58</strong><span>countries</span></div><div class=\"tt-stat\"><strong>1.8m+</strong><span>people</span></div></div></div>\n<div class=\"tt-body\"><p>Since its creation in 1982, PCM has continued to be researched and applied in a wide range of personal and professional contexts. Today, the model is practised in 58 countries, and more than 1.8 million people have experienced it.</p><p>PCM has been used by organisations including NASA, Pixar, L’Oréal, IKEA, BMW and Coca-Cola — as well as by people who want to understand themselves and communicate more effectively in everyday life.</p></div>\n</div></div>\n</section>\n\n<section class=\"tt-next\">\n<div class=\"tt-container\">\n<div class=\"tt-next-head\"><p class=\"tt-kicker\">Where to go next</p><h2 class=\"tt-section-title\">Continue exploring PCM</h2><p>If you would like to explore PCM further, you can look at it through your own experience or learn to use the model in a more systematic way.</p></div>\n<div class=\"tt-next-grid\">\n<article class=\"tt-next-card\"><h3>A personal perspective</h3><p>Explore a question from your own life or work, or discover your individual Personality Structure through a PCM Profile and Debrief. Available online or in Tallinn.</p><a class=\"tt-button\" href=\"/consultations/\">Explore consultations</a></article>\n<article class=\"tt-next-card\"><h3>Learn to use PCM</h3><p>Learn the model step by step and practise applying it to communication,<br>motivation and stress — in everyday life and at work.</p><a class=\"tt-button\" href=\"/trainings/\">Explore trainings</a></article>\n</div>\n</div>\n</section>\n</main>\n\n</div>"},"elements":[]}]